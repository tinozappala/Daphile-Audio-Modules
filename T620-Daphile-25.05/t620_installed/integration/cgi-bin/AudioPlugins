#!/usr/bin/python3
"""Read-only CGI distribution of the two root-approved native LMS packages."""
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
import urllib.parse
import xml.etree.ElementTree as ET
import uuid

HOST_ROOT=Path('/mnt/hdd/system/daphile-audio-host')
IDS={'DaphileRME','DaphileCamillaDSP'}


def recorded_bridge(template,root,expected_sha256):
    placeholder='Path('+repr('/__DAPHILE_'+'AUDIO_HOST__')+')'
    if template.count(placeholder)!=1:raise RuntimeError('Unknown repository CGI template')
    content=('#!/usr/bin/python3\n'+template.replace(placeholder,'Path('+repr(str(root))+')')).encode()
    if hashlib.sha256(content).hexdigest()!=expected_sha256:
        raise RuntimeError('Repository ownership record differs from installed source')
    return content


def ensure(root,cgi,web_uid):
    """Republish only our missing recorded bridge after a native root change.

    The root-owned record pins the exact generated bytes. An existing foreign
    path, even one appearing during publication, is never replaced.
    """
    root=Path(root);cgi=Path(cgi);record=root/'repository-cgi.json'
    if not record.exists() and not record.is_symlink():return False
    uid=os.geteuid()
    def regular(path):
        st=path.lstat()
        if path.is_symlink() or not stat.S_ISREG(st.st_mode) or st.st_uid!=uid or st.st_mode&0o022:
            raise RuntimeError('Unsafe owned repository source or record')
    if root.is_symlink() or root.stat().st_uid!=uid or root.stat().st_mode&0o022:
        raise RuntimeError('Unsafe repository host root')
    if type(web_uid) is not int or web_uid<0:raise ValueError('Explicit native web identity required')
    if cgi.is_symlink() or not cgi.is_dir() or cgi.stat().st_uid not in (uid,web_uid) or cgi.stat().st_mode&0o022:
        raise RuntimeError('Unsafe native repository CGI directory')
    regular(record)
    if record.stat().st_size>16384:raise ValueError('Oversized repository ownership record')
    owned=json.loads(record.read_text())
    if not isinstance(owned,dict) or set(owned)!={'sha256','base_url'} or not re.fullmatch('[a-f0-9]{64}',str(owned['sha256'])):
        raise ValueError('Invalid repository ownership record')
    catalog({},owned['base_url'])  # Validate the recorded URL without changing the catalog.
    source=root/'code/repository.py';regular(source)
    content=recorded_bridge(source.read_text(),root,owned['sha256'])
    pin=hashlib.sha256(content).hexdigest()
    destination=cgi/'AudioPlugins'
    if destination.exists() or destination.is_symlink():
        regular(destination)
        if hashlib.sha256(destination.read_bytes()).hexdigest()!=pin or stat.S_IMODE(destination.stat().st_mode)!=0o755:
            raise RuntimeError('Repository CGI changed externally; refusing overwrite')
        return False
    temporary=cgi/('.AudioPlugins.republish-'+uuid.uuid4().hex)
    try:
        with temporary.open('xb') as stream:
            stream.write(content);stream.flush();os.fsync(stream.fileno());os.fchmod(stream.fileno(),0o755)
        os.link(temporary,destination,follow_symlinks=False)
        if hasattr(os,'O_DIRECTORY'):
            fd=os.open(cgi,os.O_RDONLY|os.O_DIRECTORY)
            try:os.fsync(fd)
            finally:os.close(fd)
    finally:temporary.unlink(missing_ok=True)
    return True

def catalog(approvals,base_url):
    url=urllib.parse.urlsplit(base_url)
    if url.scheme not in ('http','https') or not url.netloc or url.username or url.password or url.query or url.fragment:raise ValueError('Explicit repository base URL required')
    root=ET.Element('extensions');plugins=ET.SubElement(root,'plugins')
    for name in sorted(IDS):
        rows=approvals.get(name,[])
        if not rows:continue
        entry=max(rows,key=lambda r:tuple(int(v) for v in r['version'].split('.')))
        plugin=ET.SubElement(plugins,'plugin',name=name,version=entry['version'],target='unix',minTarget=entry['minTarget'],maxTarget=entry['maxTarget'])
        ET.SubElement(plugin,'title',lang='EN').text=name
        ET.SubElement(plugin,'desc',lang='IT').text='Modulo audio autonomo. Il DSP richiede un percorso PCM preparato esplicitamente.'
        ET.SubElement(plugin,'creator').text='Daphile custom project'
        ET.SubElement(plugin,'url').text=base_url.rstrip('/')+'/'+entry['archive']
        ET.SubElement(plugin,'sha').text=entry['sha1']
    ET.SubElement(ET.SubElement(root,'details'),'title',lang='EN').text='Daphile optional audio modules'
    ET.indent(root)
    return ET.tostring(root,encoding='utf-8',xml_declaration=True)+b'\n'

def response(root,env):
    if env.get('REQUEST_METHOD','GET') not in ('GET','HEAD'):return 405,'text/plain',b'Read-only repository'
    path=env.get('PATH_INFO','')
    if path in ('/sidebar.js','/navigation.json'):
        sys.path.insert(0,str(Path(root)/'code'))
        from sidebar import SCRIPT,enabled_modules
        if path=='/sidebar.js':return 200,'text/javascript; charset=utf-8',SCRIPT.encode('utf8')
        return 200,'application/json; charset=utf-8',json.dumps({'modules':enabled_modules(root)},separators=(',',':')).encode()
    if path in ('','/','/launcher'):
        names=json.loads((Path(root)/'launcher.json').read_text()).get('modules',[])
        links={'DaphileRME':('RME · EQ Studio','PEQ hardware · cinque bande','RMEPlugin'),'DaphileCamillaDSP':('CamillaDSP · PEQ Studio','PEQ software · 24 + 24 bande','CamillaPlugin')}
        cards=''.join('<a class="card" href="/cgi-bin/'+links[n][2]+'/"><span>'+links[n][1]+'</span><strong>'+links[n][0]+'</strong><b>Apri pannello →</b></a>' for n in names if n in links)
        content='<!doctype html><html lang="it"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Plugin audio</title><style>body{margin:0;background:#0c131f;color:#e6eef8;font:16px/1.5 system-ui}main{max-width:1000px;margin:8vh auto;padding:24px}h1{font-size:38px;letter-spacing:-1px}p,span{color:#a0b2ca}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:20px;margin-top:35px}.card{display:block;padding:30px;border:1px solid #35465e;border-radius:16px;background:#172334;text-decoration:none;color:inherit}.card:hover{border-color:#70dfca}.card span,.card strong,.card b{display:block}.card strong{font-size:25px;margin:15px 0 35px}.card b{color:#70dfca;font-size:14px}</style><main><p>DAPHILE / MODULI OPZIONALI</p><h1>I tuoi plugin audio</h1><p>Apri un modulo installato e abilitato. L’accesso al pannello non modifica l’audio.</p><div class="grid">'+(cards or '<p>Nessun modulo audio attivo. Abilita il plugin dal gestore plugin di Daphile.</p>')+'</div></main></html>'
        return 200,'text/html; charset=utf-8',content.encode('utf8')
    if path=='/extensions.xml':return 200,'application/xml; charset=utf-8',(Path(root)/'repository.xml').read_bytes()
    if not re.fullmatch(r'/Daphile(?:RME|CamillaDSP)-\d+\.\d+\.\d+\.zip',path):return 404,'text/plain',b'Not found'
    approvals=json.loads((Path(root)/'approvals.json').read_text())
    entry=next((r for name in IDS for r in approvals.get(name,[]) if r['archive']==path[1:]),None)
    if entry is None:return 404,'text/plain',b'Unapproved version'
    archive=Path(root)/'bundles'/entry['archive']
    if archive.is_symlink() or not archive.is_file():raise RuntimeError('Approved package unavailable')
    content=archive.read_bytes()
    if hashlib.sha256(content).hexdigest()!=entry['sha256']:raise RuntimeError('Approved package integrity failure')
    return 200,'application/zip',content

def main():
    try:status,mime,content=response(HOST_ROOT,os.environ)
    except (OSError,RuntimeError,ValueError,KeyError,TypeError):status,mime,content=503,'text/plain',b'Approved repository unavailable'
    headers=f'Status: {status}\r\nContent-Type: {mime}\r\nContent-Length: {len(content)}\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n'
    sys.stdout.buffer.write(headers.encode())
    if os.environ.get('REQUEST_METHOD')!='HEAD':sys.stdout.buffer.write(content)

if __name__=='__main__':main()
